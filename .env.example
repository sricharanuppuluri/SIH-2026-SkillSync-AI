# ==============================================================================
# SkillSync AI - Environment Configuration Example
# ==============================================================================
# Copy this file to .env or configure backend/.env and frontend/.env.local

# Application Settings
APP_NAME=SkillSync AI
APP_ENV=development
DEBUG=True
API_V1_PREFIX=/api/v1
HOST=0.0.0.0
PORT=8000

# Security
# In production, generate a secure secret key: openssl rand -hex 32
JWT_SECRET_KEY=skillsync_development_insecure_secret_key_change_in_production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database Configuration (PostgreSQL + pgvector)
# Local development default:
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/skillsync_ai
# Sync database URL for Alembic migrations if needed:
DATABASE_URL_SYNC=postgresql://postgres:postgres@localhost:5432/skillsync_ai

# Cache & Message Broker (Redis)
REDIS_URL=redis://localhost:6379/0

# Local AI / LLM Configuration (Ollama)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=mistral:latest
OLLAMA_EMBEDDING_MODEL=nomic-embed-text:latest

# CORS Configuration (comma-separated list of allowed origins)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Frontend Configuration (used by Next.js)
NEXT_PUBLIC_API_URL=http://localhost:8000
